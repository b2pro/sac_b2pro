# production (o default quando esta variavel nao vem) exige um SAC_JWT_SECRET
# proprio de 32+ caracteres: sem ele o boot para, em vez de a aplicacao subir
# assinando token com segredo conhecido. Use development so na sua maquina.
SAC_ENVIRONMENT=development
SAC_DATABASE_URL=postgresql+asyncpg://sac:sac@localhost:5432/sac
# Gere o seu: python -c "import secrets; print(secrets.token_urlsafe(48))"
SAC_JWT_SECRET=
# Use um TLD real (ex.: .com); enderecos .local/.test sao rejeitados pela validacao de email do login.
SAC_SEED_ADMIN_EMAIL=
SAC_SEED_ADMIN_PASSWORD=
